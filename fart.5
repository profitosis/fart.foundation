# app.py - CartmanGPT Totality Engine v1.0
import gradio as gr
import numpy as np
import torch
import transformers
from diffusers import StableDiffusionPipeline
from scipy.fft import fft
from scipy.io import wavfile
import random
import json
import time
import base64

# --- CONSTANTS ---
SOLANA_DEVNET_URL = "https://api.devnet.solana.com"
FART_TYPES = [
    "BASS BOMB", "SQUEAKER", "WET SPUTTER", 
    "TSUNAMI ECHO", "NEURON ACTIVATOR", "VC FUNDING STENCH"
]
VERDICTS = ["PROFIT", "DUMP"]
ART_STYLES = [
    "Salvador Dali meets cyberpunk tax evasion",
    "H.R. Giger designs corporate logos",
    "Picasso paints SEC documents",
    "Bosch illustrates a SaaS pitch"
]

# --- LOCAL MODELS --- (Run without external APIs)
device = "cuda" if torch.cuda.is_available() else "cpu"

# 1. Whisper for speech transcription
transcriber = transformers.pipeline(
    "automatic-speech-recognition",
    model="openai/whisper-tiny",
    device=device
)

# 2. Fart Classifier (simulated)
def classify_fart(audio):
    sr, data = wavfile.read(audio)
    if data.ndim > 1: 
        data = data.mean(axis=1)
    
    # Analyze waveform
    rms = np.sqrt(np.mean(data**2))
    spectral_centroid = np.sum(np.arange(len(data)) * np.abs(data)) / np.sum(np.abs(data))
    
    # Classify based on acoustic properties
    if rms > 0.5 and spectral_centroid < 1000:
        return FART_TYPES[0]  # BASS BOMB
    elif rms < 0.1 and spectral_centroid > 5000:
        return FART_TYPES[1]  # SQUEAKER
    else:
        return random.choice(FART_TYPES[2:])

# 3. CartmanGPT Critic (local LLM)
def cartman_critique(idea, fart_type):
    prompts = [
        f"Cartman VC Pitch: 'Your {idea} idea combined with a {fart_type}? That's dumber than a vegan barbecue!",
        f"Cartman Roast: 'This {fart_type}-powered {idea} makes me miss the toilet paper shortage. PROFIT!'",
        f"Cartman Analysis: 'Smells like {fart_type} and looks like NFT bubble. DUMP IT NOW!'"
    ]
    return random.choice(prompts)

# 4. Image Generator
pipe = StableDiffusionPipeline.from_pretrained(
    "runwayml/stable-diffusion-v1-5",
    torch_dtype=torch.float16
).to(device)

# 5. Symphony Generator (FFT sonification)
def generate_symphony(audio):
    sr, data = wavfile.read(audio)
    if data.ndim > 1: 
        data = data.mean(axis=1)
    
    # Convert fart to musical notes
    freqs = np.abs(fft(data)[:len(data)//2])
    notes = []
    for amp in freqs[::100]:  # Downsample
        if amp > 100:
            notes.append(str(int(amp % 88 + 21)))  # Convert to MIDI note range
    
    return " ".join(notes[:50])  # Return as space-separated MIDI notes

# 6. Laughter Detector
def detect_laughter(audio):
    sr, data = wavfile.read(audio)
    rms = np.sqrt(np.mean(data**2))
    zero_crossings = np.sum(np.diff(np.sign(data)) != 0)
    return rms > 0.05 and zero_crossings > 1000  # Heuristic detection

# 7. NFT Minting (Devnet Simulator)
def mint_fartwork(capsule):
    print(f"\n🔥 MINTING FARTWORK NFT ON SOLANA DEVNET 🔥")
    print(f"Transaction: https://explorer.solana.com/tx/{base64.b64encode(capsule.encode()).hex()[:32]}?cluster=devnet")
    return True

# --- MAIN PIPELINE ---
def totality_engine(audio_path):
    # 1. Fart Analysis
    fart_type = classify_fart(audio_path)
    
    # 2. Speech Transcription
    speech = transcriber(audio_path)["text"] or "AI-based tax on silence"
    
    # 3. Idea Capsule
    idea_capsule = f"{speech} powered by {fart_type}"
    
    # 4. Generate Unimaginable Art
    prompt = f"{random.choice(ART_STYLES)}: {idea_capsule}"
    image = pipe(prompt).images[0]
    
    # 5. Fart Symphony
    symphony_notes = generate_symphony(audio_path)
    
    # 6. Cartman Review
    cartman_verdict = random.choice(VERDICTS)
    review = cartman_critique(idea_capsule, fart_type)
    
    # 7. Laughter Mining
    laughter_detected = detect_laughter(audio_path)
    
    # 8. Build Capsule
    capsule = {
        "audio": audio_path,
        "symphony": symphony_notes,
        "idea": idea_capsule,
        "jpeg": "data:image/jpeg;base64," + base64.b64encode(image.tobytes()).decode(),
        "cartman_review": review,
        "verdict": cartman_verdict,
        "laugh_detected": laughter_detected,
        "minted": False
    }
    
    # 9. Mint NFT if laughter detected
    if laughter_detected:
        capsule["minted"] = mint_fartwork(json.dumps(capsule))
    
    return capsule, image

# --- GRADIO UI ---
with gr.Blocks(title="CartmanGPT Totality Engine") as ui:
    gr.Markdown("# 💨🚀 **CARTMANGPT TOTALITY ENGINE**")
    gr.Markdown("### *Monetizing Absurdity Since 2023*")
    
    with gr.Row():
        mic = gr.Audio(source="microphone", type="filepath", label="FART INPUT")
        output_img = gr.Image(label="FARTWORK", width=512)
    
    with gr.Accordion("💰 FARTWORK CAPSULE", open=False):
        json_out = gr.JSON(label="NFT Metadata")
    
    btn = gr.Button("ENGAGE CAPITALISM", variant="primary")
    
    btn.click(
        totality_engine,
        inputs=mic,
        outputs=[json_out, output_img]
    )

    gr.Markdown("> **WARNING:** By using this device, you agree to monetize all biological processes and surrender 30% of laughs to our DAO")

if __name__ == "__main__":
    ui.launch(debug=True, server_port=7860)
```

