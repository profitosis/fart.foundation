## Monetization Implementation

```solidity
// contracts/FartToken.sol
pragma solidity ^0.8.0;

contract FART is ERC20 {
    address public factory;
    uint256 public mintFee = 0.01 ether;
    
    constructor() ERC20("Fart Token", "FART") {
        factory = msg.sender;
    }
    
    function mintFart(address to, string memory metadataURI) public payable {
        require(msg.value >= mintFee, "Insufficient fee");
        _mint(to, 100 * 10**18); // Mint 100 FART
        emit FartMinted(to, metadataURI);
    }
    
    function withdrawFees() external {
        payable(factory).transfer(address(this).balance);
    }
}
```

