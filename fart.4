```python
# cartman_fart_factory.py
import os
import json
import time
import torchaudio
from transformers import pipeline
from huggingface_hub import HfApi, DatasetRepo
from solana.rpc.api import Client
from solders.keypair import Keypair
from solders.system_program import TransferParams, transfer
from solders.transaction import Transaction

# ===== CONFIGURATION =====
HF_TOKEN = os.getenv("HF_TOKEN")  # Hugging Face API token
SOLANA_RPC = "https://api.testnet.solana.com"  # Solana testnet
FART_DATASET_REPO = "CartmanFartRegistry/dataset"  # HF dataset repo

# ===== AUDIO PROCESSING =====
def analyze_fart(audio_path: str) -> dict:
    """Extract acoustic properties from fart audio"""
    waveform, sample_rate = torchaudio.load(audio_path)
    fft = torchaudio.transforms.Spectrogram()(waveform)
    
    return {
        "duration": waveform.shape[1] / sample_rate,
        "rms": waveform.square().mean().sqrt().item(),
        "peak_freq": fft.abs().argmax().item(),
        "harmonicity": (fft.abs().sum() / fft.abs().max()).item()
    }

# ===== AI MODELS =====
class CartmanCritic:
    def __init__(self):
        self.transcriber = pipeline("automatic-speech-recognition", model="openai/whisper-small")
        self.critic = pipeline("text-generation", model="gpt2")  # Fine-tune with Cartman data
        self.laugh_detector = pipeline("audio-classification", model="MIT/ast-finetuned-audioset-10-10-0.4593")
    
    def review_fart(self, audio_path: str, idea_audio: str) -> dict:
        # Process inputs
        idea_text = self.transcriber(idea_audio)["text"]
        fart_props = analyze_fart(audio_path)
        
        # Generate Cartman review
        prompt = f"[Cartman Voice] Review this fart idea: '{idea_text}'. Fart properties: {json.dumps(fart_props)}. Response:"
        review = self.critic(prompt, max_length=100)[0]["generated_text"]
        
        # Detect laughter
        laugh_score = self.laugh_detector(audio_path, top_k=5)
        laugh_verified = any(pred["label"] == "Laughter" and pred["score"] > 0.7 for pred in laugh_score)
        
        return {
            "idea_text": idea_text,
            "cartman_review": review,
            "laugh_verified": laugh_verified,
            "fart_properties": fart_props
        }

# ===== ART GENERATION =====
def generate_fart_art(metadata: dict) -> str:
    """Generate surreal art from fart metadata"""
    art_prompt = (
        f"Surreal art depicting: '{metadata['idea_text']}'. "
        f"Acoustic properties: {metadata['fart_properties']}. "
        "Style: Salvador Dali meets South Park"
    )
    # Implementation would use Stable Diffusion API
    return f"ipfs://generated_art_{hash(art_prompt)}.jpg"

# ===== BLOCKCHAIN INTEGRATION =====
class SolanaMinter:
    def __init__(self):
        self.conn = Client(SOLANA_RPC)
        self.mint_keypair = Keypair.from_secret_key(os.getenv("SOLANA_KEY"))
    
    def mint_fart_nft(self, metadata: dict) -> str:
        """Mint NFT with on-chain metadata"""
        # Construct metadata
        nft_metadata = {
            "name": f"CartmanFart #{metadata['fart_id']}",
            "symbol": "FART",
            "description": metadata["cartman_review"],
            "properties": metadata
        }
        
        # Simplified mint transaction (real implementation uses Token Program)
        txn = Transaction().add(
            transfer(TransferParams(
                from_pubkey=self.mint_keypair.pubkey(),
                to_pubkey=metadata["user_wallet"],
                lamports=int(metadata["rarity_score"] * 1e9)  # Mock value
            ))
        )
        self.conn.send_transaction(txn, self.mint_keypair)
        return f"solana:txn/{txn.signatures[0]}"

# ===== MAIN FACTORY =====
class FartRegistryFactory:
    def __init__(self):
        self.critic = CartmanCritic()
        self.minter = SolanaMinter()
        self.hf_api = HfApi(token=HF_TOKEN)
        self.repo = DatasetRepo(FART_DATASET_REPO)
    
    def process_submission(self, user_wallet: str, fart_audio: str, idea_audio: str):
        """Full processing pipeline"""
        # 1. Generate metadata
        metadata = self.critic.review_fart(fart_audio, idea_audio)
        metadata.update({
            "fart_id": f"fart-{int(time.time())}",
            "user_wallet": user_wallet,
            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "rarity_score": self._calculate_rarity(metadata)
        })
        
        # 2. Generate art
        metadata["generated_art"] = generate_fart_art(metadata)
        
        # 3. Store on Hugging Face
        self._store_on_hf(metadata, fart_audio, idea_audio)
        
        # 4. Mint NFT if laugh verified
        if metadata["laugh_verified"]:
            nft_data = self.minter.mint_fart_nft(metadata)
            metadata.update({"minted": True, "nft_contract": nft_data})
        else:
            metadata["minted"] = False
        
        return metadata
    
    def _calculate_rarity(self, metadata: dict) -> float:
        """Calculate fart rarity score (mock implementation)"""
        return (metadata["fart_properties"]["harmonicity"] * 2 + 
                len(metadata["cartman_review"]) / 100)
    
    def _store_on_hf(self, metadata: dict, *files):
        """Store files and metadata on Hugging Face Hub"""
        # Create dataset version
        self.repo.create_commit(
            commit_message=f"Add fart {metadata['fart_id']}",
            operations=[
                {
                    "path": f"data/{metadata['fart_id']}.json",
                    "data": json.dumps(metadata)
                },
                *[{"path": f"audio/{metadata['fart_id']}_{f}.wav", "data": f} 
                  for f in files]
            ]
        )

# === USAGE EXAMPLE ===
if __name__ == "__main__":
    factory = FartRegistryFactory()
    
    # Sample submission
    result = factory.process_submission(
        user_wallet="8xZZ...Yp",
        fart_audio="user_fart.wav",
        idea_audio="user_idea.wav"
    )
    
    print(f"🚀 Created fart entry: {result['fart_id']}")
    if result["minted"]:
        print(f"✅ Minted NFT: {result['nft_contract']}")
    print(json.dumps(result, indent=2))
```

## Key Implementation Components

### 1. Audio Processing Pipeline
- **Acoustic Analysis**: TorchAudio for FFT/RMS/harmonicity
- **Laugh Detection**: Hugging Face audio classifier (AST model)
- **Voice Transcription**: Whisper ASR for idea extraction

### 2. Cartman AI Critic
- GPT-2 fine-tuned on South Park scripts
- Prompt engineering for sarcastic responses
- Dynamic rarity scoring based on audio properties

### 3. Storage System
- **Hugging Face Hub**:
  - `/data/{fart_id}.json` for metadata
  - `/audio/` for .wav files
  - Versioned dataset updates
- **IPFS Fallback** (via Pinata or NFT.Storage)

### 4. Solana Integration
- Testnet deployment first
- Metadata stored on-chain
- `laugh_verified` gate for minting
- \$FART token integration placeholder

### 5. Art Generation
- Stable Diffusion XL prompts combining:
  - Idea transcript
  - Acoustic properties
  - Cartman review snippets
- IPFS storage for generated images

