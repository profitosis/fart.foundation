        outputs=[output_audio, output_idea, output_art, output_review, tts_output]
    )
    
    # Minting mechanism
    mint_btn.click(
        fn=lambda c: factory.db.add_item(c),
        inputs=[output_audio],
        outputs=[dataset_view]
    )

# ==============
# FART LEDGER
# ==============
class FartDatabase:
    def __init__(self):
        self.schema = {
            "id": Value("string"),
            "timestamp": Value("string"),
            "audio": Audio(sampling_rate=16000),
            "idea": Value("string"),
            "fart_type": Value("string"),
            "art": Image(),
            "review": Value("string"),
            "token_value": Value("float32")
        }
        self.dataset = Dataset.from_dict({k: [] for k in self.schema.keys()})
    
    def add_item(self, capsule):
        """Add Fartifact™ to decentralized ledger"""
        self.dataset = self.dataset.add_item(capsule)
        self.dataset.push_to_hub("fart_db", private=False)
        return self.dataset.to_pandas().tail(10)

