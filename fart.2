    with gr.Row():
        record_btn = gr.Button("💨 RECORD FART + IDEA", variant="primary")
        mint_btn = gr.Button("🪙 MINT FARTWORK NFT", variant="secondary")
    
    with gr.Tab("Fartifact™ Capsule"):
        gr.Markdown("### FART-TO-ART PRODUCTION LINE")
        output_audio = gr.Audio(label="Fart Audio", interactive=False)
        output_idea = gr.Textbox(label="Idea Capsule")
        output_art = gr.Image(label="Unimaginable Art")
        output_review = gr.Textbox(label="Cartman VC Verdict")
        tts_output = gr.Audio(label="Cartman Roast", interactive=False)
    
    with gr.Tab("Fart Database"):
        gr.Markdown("### GLOBAL FART LEDGER")
        dataset_view = gr.Dataframe(headers=["ID", "Idea", "Fart Type", "Token Value"])
    
    # Production line
    record_btn.click(
