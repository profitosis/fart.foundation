# ========== AUDIO PROCESSING ==========
def save_wav(audio, sr):
    audio = np.clip(audio, -1, 1)
    audio16 = (audio * 32767).astype(np.int16)
    fname = f"fart_{datetime.now().strftime('%Y%m%d_%H%M%S')}.wav"
    path = os.path.join(AUDIO_DIR, fname)
    wavfile.write(path, sr, audio16)
    return path

def make_waveform(audio, sr):
    t = np.linspace(0, len(audio)/sr, len(audio))
    fig = plt.figure(figsize=(8, 3), facecolor='none')
    ax = fig.add_subplot(111)
    ax.plot(t, audio, color='#ff8c00', linewidth=1.5)
    ax.set_title("FART WAVEFORM", color='#ff8c00')
    ax.set_xlabel("Time (s)", color='#ff8c00')
    ax.set_ylabel("Amplitude", color='#ff8c00')
    ax.tick_params(colors='#ff8c00')
    ax.spines['bottom'].set_color('#ff8c00')
    ax.spines['top'].set_color('#ff8c00') 
    ax.spines['right'].set_color('#ff8c00')
    ax.spines['left'].set_color('#ff8c00')
    ax.set_facecolor('#1a1a1a')
    fig.patch.set_alpha(0.0)
    plt.tight_layout()
    
    buf = io.BytesIO()
    plt.savefig(buf, format="png", transparent=True)
    plt.close(fig)
    buf.seek(0)
    return Image.open(buf)

def make_spectrogram(audio, sr):
    fig = plt.figure(figsize=(8, 3), facecolor='none')
    ax = fig.add_subplot(111)
    ax.specgram(audio, Fs=sr, cmap='hot', 
               vmin=-20, vmax=50, 
               scale='dB', scale_by_freq=True)
    ax.set_title("FART SPECTROGRAM", color='#ff8c00')
    ax.set_xlabel("Time (s)", color='#ff8c00')
    ax.set_ylabel("Frequency (Hz)", color='#ff8c00')
    ax.tick_params(colors='#ff8c00')
    ax.spines['bottom'].set_color('#ff8c00')
    ax.spines['top'].set_color('#ff8c00') 
    ax.spines['right'].set_color('#ff8c00')
    ax.spines['left'].set_color('#ff8c00')
    ax.set_facecolor('#1a1a1a')
    fig.patch.set_alpha(0.0)
    plt.tight_layout()
    
    buf = io.BytesIO()
    plt.savefig(buf, format="png", transparent=True)
    plt.close(fig)
    buf.seek(0)
    return Image.open(buf)

# ========== FEATURE ANALYSIS ==========
def analyze_fart(audio, sr):
    duration = len(audio) / sr
    
    if audio.ndim > 1:
        audio = audio.mean(axis=1)
    
    # Calculate RMS energy (pressure)
    rms = np.sqrt(np.mean(audio**2))
    
    # Calculate pitch using FFT
    fft = np.fft.rfft(audio)
    frequencies = np.fft.rfftfreq(len(audio), 1/sr)
    magnitude = np.abs(fft)
    pitch = frequencies[np.argmax(magnitude)] if len(frequencies) > 0 else 0
    
    # Simple complexity measure
    spectral_flatness = np.exp(np.mean(np.log(magnitude + 1e-10))) / (np.mean(magnitude) + 1e-10)
    
    # Mood classification
    if pitch > 1000 or rms > 0.5:
        mood = "EXCITED"
    elif pitch > 500:
        mood = "HAPPY"
    else:
        mood = "CHILL"
    
    return {
        'duration': duration,
        'pressure': float(rms),
        'pitch': float(pitch),
        'complexity': float(spectral_flatness),
        'mood': mood
    }

