# ========== PIPELINE ==========
def full_fart_pipeline(audio_tuple):
    if not audio_tuple:
        return None, None, "", "", "", "", "", "", ""
    
    sr, audio = audio_tuple
    if audio.ndim > 1:
        audio = audio.mean(axis=1)
    
    # Save audio
    wav_path = save_wav(audio, sr)
    
    # Analyze features
    feats = analyze_fart(audio, sr)
    
    # Generate visuals
    waveform_img = make_waveform(audio, sr)
    spectrogram_img = make_spectrogram(audio, sr)
    
    # Generate content
    theme = choose_theme()
    narrative = generate_narrative(feats, theme)
    fart_badge = create_fart_badge(feats['pitch'], feats['pressure'])
    
    # Create neuro cards
    pressure_card = create_neuro_card("PRESSURE", f"{feats['pressure']:.3f}")
    pitch_card = create_neuro_card("PITCH", f"{feats['pitch']:.0f} Hz")
    duration_card = create_neuro_card("DURATION", f"{feats['duration']:.2f} s")
    mood_card = create_neuro_card("MOOD", feats['mood'])
    theme_card = create_neuro_card("THEME", theme.title())
    
    return (
        waveform_img, 
        spectrogram_img,
        pressure_card,
        pitch_card,
        duration_card,
        mood_card,
        theme_card,
        narrative,
        fart_badge
    )

