# ========== FART CLASSIFICATION ==========
def classify_fart_type(pitch, pressure):
    if pressure > 0.5 and pitch < 200:
        return "bass drop"
    elif pitch > 800:
        return "whistler"
    elif 200 < pitch < 600 and pressure > 0.3:
        return "rippler"
    elif pressure < 0.1:
        return "invisible"
    else:
        return "surprise"

def type_to_emoji(fart_type):
    return FART_TYPES.get(fart_type, "🎵")

def fart_type_tag(pitch, pressure):
    fart_type = classify_fart_type(pitch, pressure)
    return f"{type_to_emoji(fart_type)} {fart_type.title()}"

