# 🗄️ `fart_db.py` — SQLite schema + typed helper

```python
#!/usr/bin/env python3
# fart_db.py — FARTORY™ persistence, API-less, SQLite
import os, json, sqlite3
from datetime import datetime
from typing import Optional, Dict, Any, List, Tuple

DB_PATH = os.environ.get("FARTORY_DB", "fartory.sqlite")

DDL = """
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS fartifacts (
  id TEXT PRIMARY KEY,
  user_id TEXT,
  ts_utc TEXT NOT NULL,
  idea_text TEXT,
  idea_summary TEXT,
  cartman_review TEXT,
  verdict TEXT,                -- PROFIT | DUMP
  token_price_estimate REAL,
  laugh_verified INTEGER,      -- 0/1
  mint_tx TEXT,                -- solana tx or NULL
  token_minted INTEGER DEFAULT 0,
  audio_rms REAL,
  audio_snr_db REAL,
  audio_fft_peak REAL,
  art_hash TEXT,
  meta_json TEXT               -- json blob for misc fields
);
CREATE TABLE IF NOT EXISTS assets (
  fartifact_id TEXT,
  kind TEXT,                   -- fart_wav | symphony_mp3 | image_jpeg | metadata_json
  uri TEXT,                    -- ipfs://... or local path
  PRIMARY KEY (fartifact_id, kind),
  FOREIGN KEY (fartifact_id) REFERENCES fartifacts(id) ON DELETE CASCADE
);
"""

def connect(db_path: str = DB_PATH) -> sqlite3.Connection:
  conn = sqlite3.connect(db_path, check_same_thread=False)
  conn.execute("PRAGMA foreign_keys=ON;")
  for stmt in DDL.strip().split(";\n"):
    if stmt.strip():
      conn.execute(stmt)
  conn.commit()
  return conn

def upsert_fartifact(conn: sqlite3.Connection,
                     id: str,
                     user_id: str,
                     idea_text: str,
                     idea_summary: str,
                     cartman_review: str,
                     verdict: str,
                     price_estimate: float,
                     laugh_verified: bool,
                     audio_rms: float,
                     audio_snr_db: float,
                     audio_fft_peak: float,
                     art_hash: str,
                     meta: Dict[str, Any],
                     assets: List[Tuple[str,str]]) -> None:
  ts = datetime.utcnow().isoformat()
  conn.execute("""
    INSERT INTO fartifacts(id,user_id,ts_utc,idea_text,idea_summary,cartman_review,verdict,
      token_price_estimate,laugh_verified,mint_tx,token_minted,audio_rms,audio_snr_db,audio_fft_peak,art_hash,meta_json)
    VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
    ON CONFLICT(id) DO UPDATE SET
      idea_text=excluded.idea_text,
      idea_summary=excluded.idea_summary,
      cartman_review=excluded.cartman_review,
      verdict=excluded.verdict,
      token_price_estimate=excluded.token_price_estimate,
      laugh_verified=excluded.laugh_verified,
      audio_rms=excluded.audio_rms,
      audio_snr_db=excluded.audio_snr_db,
      audio_fft_peak=excluded.audio_fft_peak,
      art_hash=excluded.art_hash,
      meta_json=excluded.meta_json
  """, (id,user_id,ts,idea_text,idea_summary,cartman_review,verdict,
        float(price_estimate), int(laugh_verified), None, 0,
        float(audio_rms), float(audio_snr_db), float(audio_fft_peak), art_hash,
        json.dumps(meta or {})))
  # assets
  for kind, uri in assets:
    conn.execute("""
      INSERT INTO assets(fartifact_id,kind,uri)
      VALUES(?,?,?)
      ON CONFLICT(fartifact_id,kind) DO UPDATE SET uri=excluded.uri
    """, (id, kind, uri))
  conn.commit()

def set_minted(conn: sqlite3.Connection, id: str, tx: str):
  conn.execute("UPDATE fartifacts SET token_minted=1, mint_tx=? WHERE id=?", (tx, id))
  conn.commit()

def get_recent(conn: sqlite3.Connection, n: int = 20):
  cur = conn.execute("""
    SELECT id, ts_utc, verdict, token_price_estimate, laugh_verified, art_hash
    FROM fartifacts ORDER BY ts_utc DESC LIMIT ?""", (n,))
  return cur.fetchall()
```

