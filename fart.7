# 🧮 `pricing.py` — token price discovery (offline)

```python
#!/usr/bin/env python3
# pricing.py — FARTORY™ price model (offline)
import hashlib
import numpy as np

def _hash_to_rand(s: str) -> float:
    # stable 0..1
    h = hashlib.sha256(s.encode()).digest()
    return int.from_bytes(h[:8], 'big') / float(2**64 - 1)

def estimate_price_usd(
    fart_rms: float,
    idea_score: float,        # 0..1 (LLM quality scoring)
    cartman_sentiment: float, # -1..1
    laugh_verified: bool,
    art_hash: str
) -> float:
    # Base from pressure (rms)
    base = max(0.0005, fart_rms * 0.05)        # 0.002 @ rms=0.04
    # idea contribution
    idea = 0.01 * max(0, idea_score)**1.2
    # cartman sentiment
    sent = 0.006 * max(0, (cartman_sentiment+1)/2.0)
    # laugh bonus
    laugh = 0.008 if laugh_verified else 0.0
    # originality jitter
    jitter = 0.008 * (0.3 + 0.7*_hash_to_rand(art_hash))

    price = base + idea + sent + laugh + jitter
    return round(price, 6)  # keep it meme‑micro
```

