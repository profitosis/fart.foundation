# 🧠 `llm_cartman.py` — local Cartman judge (tiny, keyless)

```python
#!/usr/bin/env python3
# llm_cartman.py — tiny local LLM Cartman (CPU friendly)
from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline

MODEL = "TinyLlama/TinyLlama-1.1B-Chat-v1.0"
_tok = AutoTokenizer.from_pretrained(MODEL)
_mod = AutoModelForCausalLM.from_pretrained(MODEL)
_chat = pipeline("text-generation", model=_mod, tokenizer=_tok, max_new_tokens=256, do_sample=True, temperature=0.85, top_p=0.92)

SYSTEM = ("You are Eric Cartman from South Park. Greedy, sarcastic, blunt. "
          "Light profanity only. Be concise. Output tight answers.")

def _run(prompt, temperature=0.8, max_new_tokens=200):
    text = f"<|system|>\n{SYSTEM}\n<|user|>\n{prompt}\n<|assistant|>\n"
    out = _chat(text, temperature=temperature, max_new_tokens=max_new_tokens)[0]["generated_text"]
    return out.split("<|assistant|>")[-1].strip()

def summarize(text):
    p = f"Summarize the BUSINESS IDEA in 1-2 sentences in Cartman's investor voice.\n\n{text}"
    return _run(p, temperature=0.6, max_new_tokens=120)

def critique(summary):
    p = f"Challenge this idea with sarcasm; give one risk and one monetization tactic: {summary}"
    return _run(p, temperature=0.9, max_new_tokens=120)

def verdict(debate_lines):
    p = ("Based on this debate, output exactly 'PROFIT' or 'DUMP' on the first line, "
         "then a one-line sarcastic comment.\n\n" + "\n".join(debate_lines[-6:]))
    return _run(p, temperature=0.25, max_new_tokens=40)

def score_quality(summary):
    # crude 0..1: length & keywords
    kw = ["profit","subscription","ads","ai","automation","market","scale","moat","margins"]
    s = summary.lower()
    base = min(1.0, max(0.1, len(summary)/180.0))
    bonus = sum(k in s for k in kw)/len(kw)
    return max(0.0, min(1.0, 0.5*base + 0.5*bonus))
```

