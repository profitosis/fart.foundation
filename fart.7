# 🫧 `media_ops.py` — audio utils, MIDI, image stub (offline)

```python
#!/usr/bin/env python3
# media_ops.py — audio analysis, MIDI synth, image gen stub
import os, math, uuid
import numpy as np
import soundfile as sf
import librosa
from PIL import Image, ImageDraw, ImageFont

SAMPLERATE = 16000

def load_mono16k(path):
    y, sr = librosa.load(path, sr=SAMPLERATE, mono=True)
    return y.astype(np.float32), SAMPLERATE

def rms(x): 
    return float(np.sqrt(np.mean(x**2))) if len(x) else 0.0

def fft_peak_hz(x, sr):
    if len(x)==0: return 0.0
    n = min(len(x), sr*3)
    win = x[:n] * np.hanning(n)
    spec = np.fft.rfft(win)
    freq = np.fft.rfftfreq(n, 1.0/sr)
    return float(freq[np.argmax(np.abs(spec))])

def laugh_detect(y):
    # silly: energy spikes + zero-cross rate proxy
    zcr = np.mean(librosa.feature.zero_crossing_rate(y, frame_length=1024, hop_length=512))
    e = rms(y)
    return bool(e>0.02 and zcr>0.12)

def fart_to_melody(y, sr):
    # map FFT peaks over windows to MIDI notes
    H = 2048; hop = 1024
    f0s = []
    for i in range(0, len(y)-H, hop):
        seg = y[i:i+H]
        peak = fft_peak_hz(seg, sr)
        midi = 69 + 12*math.log2(max(peak,1e-6)/440.0) if peak>0 else 0
        f0s.append(int(round(np.clip(midi, 40, 88))))  # E2..E6
    return f0s or [60]

def melody_to_wav(notes, out_wav, dur_per_note=0.18, sr=SAMPLERATE):
    t = np.arange(int(len(notes)*dur_per_note*sr))/sr
    y = np.zeros_like(t, dtype=np.float32)
    idx=0
    for n in notes:
        f = 440.0 * (2**((n-69)/12))
        tt = np.arange(int(dur_per_note*sr))/sr
        tone = 0.4*np.sin(2*np.pi*f*tt) + 0.1*np.sin(2*np.pi*2*f*tt)
        a = np.hanning(len(tone))
        tone = (tone*a).astype(np.float32)
        y[idx:idx+len(tone)] += tone[:max(0,len(y)-idx)]
        idx += len(tone)
    sf.write(out_wav, y, sr)
    return out_wav

def generate_absurd_art(text, out_path, seed=0):
    # placeholder “AI JPEG”: bold typographic meme card (no external API)
    W,H = 1024, 1024
    img = Image.new("RGB",(W,H),(18,18,18))
    d = ImageDraw.Draw(img)
    # orange frame
    d.rectangle([16,16,W-16,H-16], outline=(255,106,0), width=12)
    # title
    d.text((48,48), "FARTORY™", fill=(255,174,0), anchor="la")
    body = (text[:240] + ("..." if len(text)>240 else "")) or "Untitled Emission"
    d.text((48,160), body, fill=(255,214,120))
    img.save(out_path, quality=92)
    return out_path
