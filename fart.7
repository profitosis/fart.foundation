#!/usr/bin/env python3
# agent.py — FARTORY™ agent: from audio file -> fartifact
import os, uuid
from datetime import datetime

from fart_db import connect, upsert_fartifact, set_minted
from media_ops import load_mono16k, rms, fft_peak_hz, fart_to_melody, melody_to_wav, generate_absurd_art
from llm_cartman import summarize, critique, verdict, score_quality
from pricing import estimate_price_usd
# from mint_solana import mint_nft_devnet  # optional

def process_audio_file(audio_path: str, user_id: str = "anon"):
    y, sr = load_mono16k(audio_path)
    f_id = f"fart-{uuid.uuid4().hex[:8]}"
    # analysis
    pressure = rms(y)
    peak = fft_peak_hz(y, sr)
    # "speech" is handled elsewhere; here we pretend idea text comes from a transcriber
    # plug faster-whisper in your ingestion stage and pass the transcript here
    idea_text = "(transcribed speech goes here)"
    summary = summarize(idea_text)
    deb_a = critique(summary)
    deb_b = critique(summary)  # second pass as other Cartman
    ver = verdict([f"Cartman-A: {summary}", f"Cartman-A: {deb_a}", f"Cartman-B: {deb_b}"])
    ver_upper = ver.splitlines()[0].strip().upper()
    final_verdict = "PROFIT" if "PROFIT" in ver_upper and "DUMP" not in ver_upper else "DUMP"
    review = "\n".join(ver.splitlines()[1:]) or "(no comment)"

    # art + symphony
    art_path = f"art_{f_id}.jpeg"
    generate_absurd_art(summary or idea_text, art_path)
    notes = fart_to_melody(y, sr)
    song_path = f"symph_{f_id}.wav"
    melody_to_wav(notes, song_path)

    # laugh detect proxy (replace with real mic loop)
    laugh = pressure > 0.03

    # pricing
    idea_score = score_quality(summary or "")
    sentiment = +0.3 if final_verdict=="PROFIT" else -0.3
    price = estimate_price_usd(pressure, idea_score, sentiment, laugh, art_hash=f_id)

    # pretend IPFS URIs (swap with your pinning step)
    assets = [
        ("fart_wav", f"ipfs://{f_id}_orig.wav"),
        ("symphony_mp3", f"ipfs://{f_id}_song.mp3"),
        ("image_jpeg", f"ipfs://{f_id}.jpeg"),
        ("metadata_json", f"ipfs://{f_id}.json")
    ]

    # store
    conn = connect()
    upsert_fartifact(conn, id=f_id, user_id=user_id,
        idea_text=idea_text, idea_summary=summary,
        cartman_review=review, verdict=final_verdict,
        price_estimate=price, laugh_verified=laugh,
        audio_rms=pressure, audio_snr_db=0.0, audio_fft_peak=peak,
        art_hash=f_id, meta={"notes":notes, "sr":sr}, assets=assets)
    print(f"Saved fartifact {f_id} verdict={final_verdict} ${price}")

    # optional mint:
    # if laugh and final_verdict=="PROFIT":
    #     tx = mint_nft_devnet(name=f"FARTIFACT {f_id}", symbol="FART", uri=f"ipfs://{f_id}.json", keypair_path=os.path.expanduser("~/.config/solana/id.json"))
    #     set_minted(conn, f_id, tx)
    #     print("Minted:", tx)

if __name__ == "__main__":
    import sys
    if len(sys.argv)<2:
        print("usage: agent.py <audio_file.wav>")
        sys.exit(1)
    process_audio_file(sys.argv[1])
